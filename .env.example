# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Groq AI (chat model + Whisper). GROQ_CHAT_MODEL is optional and defaults to
# openai/gpt-oss-120b; set it when Groq retires that model.
GROQ_API_KEY=your-groq-api-key
GROQ_CHAT_MODEL=

# Optional: dedicated HMAC key for AI confirmation tokens (chat/audio/WhatsApp
# "please confirm this change" flow). Falls back to SUPABASE_SERVICE_ROLE_KEY
# when unset — signing with it doesn't expose it, but a dedicated secret
# decouples confirmation-token validity from service-role-key rotation.
# Generate with: openssl rand -base64 32
AI_CONFIRMATION_SECRET=

# Optional: TypeSafe API key for Jev, the System One model that gates
# auto-applied inserts. Without it, an insert the assistant proposes while
# answering a question — or one carrying a figure you never said — is written
# straight to the database; with it, those are held for confirmation instead.
# Unset, the gate is skipped and inserts behave exactly as before.
# Create a key at https://typesafe.ai (metered: ~USD 0.0004 per check).
TYPESAFE_API_KEY=

# WhatsApp Business Cloud API
WHATSAPP_VERIFY_TOKEN=your-custom-verify-token
WHATSAPP_ACCESS_TOKEN=your-meta-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
# Meta app secret — required to authenticate webhook POSTs (X-Hub-Signature-256)
WHATSAPP_APP_SECRET=your-meta-app-secret
